# Frank Body Image Studio — environment variables
# Local dev: copy to `.env`. Production: set as Worker/Lovable secrets.
# Read ONLY inside server functions/handlers (never module scope).

# --- Image model providers (server-only secrets) ---
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# --- Supabase ---
# In Lovable Cloud these are injected automatically when you connect Supabase.
# For standalone/local runs, set them yourself:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=    # the anon/publishable key (used by auth middleware)
SUPABASE_SERVICE_ROLE_KEY=   # server-only; admin client
