# Frank Body Image Studio — environment variables
# Copy to `.env` for local dev. In production set these as Cloudflare Worker
# secrets. Read them ONLY inside functions/handlers (CF Workers binds env at
# request time — see src/lib/config.server.ts).

# --- Image model providers (server-only secrets) ---
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# --- Supabase (Phase 1) ---
# Public (client + server) — RLS-bound:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only (privileged writes / bucket admin):
SUPABASE_SERVICE_ROLE_KEY=
