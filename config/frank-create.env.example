# Copy this file to user\frank_create\provider_keys.env and fill only the providers you want to demo.
# Keep the real provider_keys.env file out of git. The /user/ folder is ignored.

# Preferred: a single Lovable AI key unlocks Nano Banana Pro / NB 2 through the
# Lovable AI Gateway without needing your own Google/OpenAI/Replicate keys.
LOVABLE_API_KEY=

# Optional: only needed if you want to bypass Lovable AI and call providers directly.
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
